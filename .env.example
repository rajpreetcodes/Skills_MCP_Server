# Skills MCP Server Configuration
# Copy to .env and customize

# Skill library root (Windows path for local, /skills for Docker)
SKILL_ROOT=C:\Users\rajpr\.claude\skills

# Profile directory (relative to project root)
PROFILE_DIR=profiles

# Transport mode: stdio (local) or http (remote/Tasklet)
TRANSPORT=stdio

# HTTP server settings (for HTTP transport)
HOST=0.0.0.0
PORT=8000

# Logging
LOG_LEVEL=INFO

# Authentication token required for HTTP mode unless --no-auth is explicit
# Generate a secure token: python -c "import secrets; print(secrets.token_urlsafe(32))"
AUTH_TOKEN=

# Rate Limiting (for HTTP transport)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60

# Search ambiguity margin in additive relevance-score points (default 2.0)
SKILL_AMBIGUITY_THRESHOLD=2.0

# Append-only skill selection correction log (default below)
CORRECTION_LOG_PATH=data/skill-selection-corrections.jsonl

# For local STDIO mode, no auth needed
# For local unauthenticated HTTP development only, pass --no-auth explicitly