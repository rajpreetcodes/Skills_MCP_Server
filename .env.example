# Skills MCP Server Configuration
# Copy to .env and customize

# Skill library root (Windows path for local, /skills for Docker)
SKILL_ROOT=C:\Users\rajpr\.claude\skills

# Profile directory (relative to project root)
PROFILE_DIR=profiles

# Transport mode: stdio (local) or http (remote/Tasklet)
TRANSPORT=stdio

# HTTP server settings (for HTTP transport)
HOST=0.0.0.0
PORT=8000

# Logging
LOG_LEVEL=INFO

# Authentication token for HTTP mode (REQUIRED for production/remote)
# Generate a secure token: python -c "import secrets; print(secrets.token_urlsafe(32))"
AUTH_TOKEN=

# For local STDIO mode, no auth needed
# For Tasklet/remote HTTP mode, SET THIS TO A SECURE VALUE